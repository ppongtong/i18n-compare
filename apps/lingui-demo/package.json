{
  "name": "lingui-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5102 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5102",
    "test": "vitest run",
    "bench": "vitest bench --run --reporter=default",
    "typecheck": "tsc -p tsconfig.json",
    "i18n:extract": "lingui extract --clean"
  },
  "dependencies": {
    "@i18n-compare/shared": "workspace:*",
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@lingui/cli": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
