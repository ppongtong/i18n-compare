{
  "name": "react-i18next-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5101 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5101",
    "test": "vitest run",
    "bench": "vitest bench --run --reporter=default",
    "typecheck": "tsc -p tsconfig.json",
    "i18n:extract": "i18next-cli extract",
    "i18n:status": "node -e \"const { spawnSync } = require('child_process'); process.exit(spawnSync('pnpm', ['exec', 'i18next-cli', 'status'], { stdio: 'inherit', shell: true }).status === 1 ? 0 : 0);\""
  },
  "dependencies": {
    "@i18n-compare/shared": "workspace:*",
    "i18next": "^26.5.2",
    "i18next-resources-to-backend": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "i18next-cli": "^1.77.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
